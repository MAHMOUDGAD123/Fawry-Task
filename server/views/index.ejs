<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="vite.svg" type="image/x-icon" />
    <title>NODE - FASTIFY - VITE</title>
    <style>
      * {
        box-sizing: border-box;
        user-select: none;
        padding: 0;
        margin: 0;
        scrollbar-width: none;
      }

      :root {
        --main-color: #ffd328;
        --main-color95: #ffd32895;
      }

      html {
        color-scheme: light dark;
        color: light-dark(#000000, #ffffff);
        background-color: light-dark(#eeeeee, #222222);
        font-family: monospace;
        font-weight: bold;
      }

      body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 30px;
        align-items: center;
        font-family: sans-serif;
        font-weight: bolder;
        height: 100dvh;
        min-height: 300px;
        min-width: 250px;
        text-align: center;
        padding: 10px;
        overflow: auto;
      }

      img {
        width: 100%;
        max-width: 700px;
        display: block;
        transition: filter 500ms;

        &.has-shadow:hover {
          filter: drop-shadow(0 0 90px var(--col));
        }
      }

      h2 {
        color: var(--main-color);
        font-size: 2rem;
        white-space: nowrap;
        font-weight: bolder;
      }

      .techs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 0.85rem;

        & > * {
          background-color: var(--main-color95);
          opacity: 0.75;
          padding: 7px 10px;
          border-radius: 100px;
          transition: background-color 300ms;
          
          &:hover {
            opacity: 1;
          }
        }
      }
    </style>
  </head>
  <body>
    <img src="Fawry.svg" alt="logo" />

    <h2>RESTful API</h2>

    <div class="techs">
      <span>NODEJS</span>
      <span>VITEJS</span>
      <span>FASTIFYJS</span>
    </div>
  </body>
</html>
